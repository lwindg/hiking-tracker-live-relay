    {
      "name": "size limits are enforced",
      "steps": [
        {
          "method": "POST",
          "path": "/v1/m/{mb}/{slot}/{dev}",
          "body": {
            "expiresAt": "{now+86400}",
            "items": [
              {
                "v": 1,
                "kind": "state",
                "epoch": 0,
                "seq": 0,
                "n": "AAAAAAAAAAAAAAAA",
                "c": "{rep:A:8196}"
              }
            ]
          },
          "expect": {
            "status": 413
          }
        },
        {
          "method": "POST",
          "path": "/v1/m/{mb}/{slot}/{dev:2}",
          "body": {
            "expiresAt": "{now+86400}",
            "items": [
              {
                "v": 1,
                "kind": "state",
                "epoch": 0,
                "seq": 0,
                "n": "AAAAAAAAAAAAAAAA",
                "c": "{rep:A:8192}"
              }
            ]
          },
          "expect": {
            "status": 200
          }
        },
        {
          "method": "POST",
          "path": "/v1/m/{mb}/{slot}/{dev:3}",
          "body": {
            "expiresAt": "{now+86400}",
            "items": [
              {
                "v": 1,
                "kind": "chunk",
                "epoch": 0,
                "seq": 1,
                "n": "AAAAAAAAAAAAAAAA",
                "c": "{rep:A:49156}"
              }
            ]
          },
          "expect": {
            "status": 413
          }
        },
        {
          "method": "POST",
          "path": "/v1/m/{mb}/{slot}/{dev:4}",
          "body": {
            "expiresAt": "{now+86400}",
            "items": [
              {
                "v": 1,
                "kind": "chunk",
                "epoch": 0,
                "seq": 1,
                "n": "AAAAAAAAAAAAAAAA",
                "c": "{rep:A:40000}"
              },
              {
                "v": 1,
                "kind": "chunk",
                "epoch": 0,
                "seq": 2,
                "n": "AAAAAAAAAAAAAAAA",
                "c": "{rep:A:40000}"
              }
            ]
          },
          "expect": {
            "status": 413
          }
        },
        {
