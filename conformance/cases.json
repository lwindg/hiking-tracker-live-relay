{
  "about": "Live report v1 relay conformance (contracts/live-report-v1.md §5). Run by LiveRelayConformanceTest against the in-memory relay and by run.mjs against any URL. Placeholders: {mb}/{mb2} fresh mailbox ids, {slot}/{slot2} fresh slot ids, {dev}/{dev2}/{dev:N} fresh device ids, all per case; a string that is exactly {now}, {now+N}, {now-N} or {i} becomes a number ({i} is the 1-based repeat index); {rep:X:N} expands to N copies of X. 'advance' (and 'advanceAfter', after each repeat) moves the in-memory clock or makes run.mjs wait. Cases marked virtualClockOnly need time travel and run only in-memory. 'json' matches partially: object keys listed must match, arrays must have the same length, '$num' matches any number.",
  "cases": [
    {
      "name": "health names the protocol and version",
      "steps": [
        {
          "method": "GET",
          "path": "/v1/health",
          "expect": {
            "status": 200,
            "json": {
              "protocol": "ht-live",
              "versions": [
                1
              ]
            }
          }
        }
      ]
    },
    {
      "name": "an unknown mailbox reads as empty with CORS",
      "steps": [
        {
          "method": "GET",
          "path": "/v1/m/{mb}",
          "expect": {
            "status": 200,
            "json": {
              "devices": []
            },
            "headers": {
              "access-control-allow-origin": "*"
            }
          }
        }
      ]
    },
    {
      "name": "a state is stored and read back",
      "steps": [
        {
          "method": "POST",
          "path": "/v1/m/{mb}/{slot}/{dev}",
          "body": {
            "expiresAt": "{now+86400}",
            "items": [
              {
                "v": 1,
                "kind": "state",
                "epoch": 0,
                "seq": 0,
                "n": "AAAAAAAAAAAAAAAA",
                "c": "c3RhdGU"
              }
            ]
          },
          "expect": {
            "status": 200,
            "json": {
              "receivedAt": "$num"
            }
          }
        },
        {
          "method": "GET",
          "path": "/v1/m/{mb}",
          "expect": {
            "status": 200,
            "json": {
              "devices": [
                {
                  "slotId": "{slot}",
                  "deviceId": "{dev}",
                  "receivedAt": "$num",
                  "state": {
                    "v": 1,
                    "kind": "state",
                    "epoch": 0,
                    "seq": 0,
                    "n": "AAAAAAAAAAAAAAAA",
                    "c": "c3RhdGU"
                  },
                  "chunks": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "a newer state replaces the older one",
      "steps": [
        {
          "method": "POST",
          "path": "/v1/m/{mb}/{slot}/{dev}",
          "body": {
            "expiresAt": "{now+86400}",
            "items": [
              {
                "v": 1,
                "kind": "state",
                "epoch": 0,
                "seq": 0,
                "n": "AAAAAAAAAAAAAAAA",
                "c": "Zmlyc3Q"
              }
            ]
          },
          "expect": {
            "status": 200
          }
        },
        {
          "advance": 16
        },
        {
          "method": "POST",
          "path": "/v1/m/{mb}/{slot}/{dev}",
          "body": {
            "expiresAt": "{now+86400}",
            "items": [
              {
                "v": 1,
                "kind": "state",
                "epoch": 0,
                "seq": 0,
                "n": "BBBBBBBBBBBBBBBB",
                "c": "c2Vjb25k"
              }
            ]
          },
          "expect": {
            "status": 200
          }
        },
        {
          "method": "GET",
          "path": "/v1/m/{mb}",
          "expect": {
            "status": 200,
            "json": {
              "devices": [
                {
                  "state": {
                    "n": "BBBBBBBBBBBBBBBB",
                    "c": "c2Vjb25k"
                  },
                  "chunks": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "the same chunk sequence overwrites and chunks come back in order",
      "steps": [
        {
          "method": "POST",
          "path": "/v1/m/{mb}/{slot}/{dev}",
          "body": {
            "expiresAt": "{now+86400}",
            "items": [
              {
                "v": 1,
                "kind": "chunk",
                "epoch": 0,
                "seq": 2,
                "n": "AAAAAAAAAAAAAAAA",
                "c": "dHdv"
              },
              {
                "v": 1,
                "kind": "chunk",
                "epoch": 0,
                "seq": 1,
                "n": "AAAAAAAAAAAAAAAA",
                "c": "b2xk"
              }
            ]
          },
          "expect": {
            "status": 200
          }
        },
        {
          "advance": 16
        },
        {
          "method": "POST",
          "path": "/v1/m/{mb}/{slot}/{dev}",
          "body": {
            "expiresAt": "{now+86400}",
            "items": [
              {
                "v": 1,
                "kind": "chunk",
                "epoch": 0,
                "seq": 1,
                "n": "AAAAAAAAAAAAAAAA",
                "c": "bmV3"
              }
            ]
          },
          "expect": {
            "status": 200
          }
        },
        {
          "method": "GET",
          "path": "/v1/m/{mb}",
          "expect": {
            "status": 200,
            "json": {
              "devices": [
                {
                  "state": null,
                  "chunks": [
                    {
                      "seq": 1,
                      "c": "bmV3"
                    },
                    {
                      "seq": 2,
                      "c": "dHdv"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
